{
  "appId": "com.riri.player",
  "productName": "Riri Player",
  "copyright": "Riri Player Desktop Client",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.png",
    "package.json",
    "node_modules/electron-updater/**/*",
    "node_modules/electron-log/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/electron-updater",
      "to": "node_modules/electron-updater"
    },
    {
      "from": "node_modules/electron-log",
      "to": "node_modules/electron-log"
    }
  ],
  "win": {
    "icon": "public/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "Riri.Player-Setup-${version}-win-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "Riri.Player-Portable-${version}-win-${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "feelthevenom",
    "repo": "Riri-Player"
  }
}
