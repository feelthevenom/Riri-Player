{
  "name": "riri-player",
  "version": "1.1.0",
  "description": "High-performance YouTube Music and local audio player standalone desktop client",
  "author": "Riri Player",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "npm run build:ytm && concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "build:ytm": "esbuild electron/ytm/index.ts --bundle --platform=node --format=cjs --outfile=electron/ytm-main.cjs --external:electron",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=electron/server.cjs --external:vite",
    "build:all": "npm run build && npm run build:ytm && npm run build:server",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "tsx --test src/utils/*.test.ts",
    "lint": "tsc --noEmit",
    "dist:win": "npm run build:all && electron-builder --win"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^9.5.1"
  }
}