{
  "name": "riri-player",
  "version": "1.0",
  "description": "High-performance YouTube Music and local audio player standalone desktop client",
  "author": "Riri Player",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "electron .",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=electron/server.cjs --external:vite",
    "build:all": "npm run build && npm run build:server",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit",
    "dist:win": "npm run build:all && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}